FILE = Lwave.input

# Particle parameters
Particle.electrons.nPartPerCell = 1000 # number of particles per cell

# Gaussian parameters
Particle.electrons.G0.vMean.x = "0.0"
Particle.electrons.G0.vMean.y = "-0.0037 * sin(kvarx * x)"
Particle.electrons.G0.vMean.z = "-0.0037 * cos(kvarx * x)"
Particle.electrons.G0.vThermal = 0.25 0.25 0.25
Particle.electrons.G0.vWeight = 1.0

# Function parameters
Function.Ex = "0."
Function.Ey = "0.001 * cos(kvarx * x)"
Function.Ez = "-0.001 * sin(kvarx * x)"
Function.Bx = "0.5"
Function.By = "0.005468 * sin(kvarx *x)"
Function.Bz = "0.005468 * cos(kvarx * x)"

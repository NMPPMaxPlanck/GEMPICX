# General setting
Sim.Type = "VlasovMaxwell"

# Grid parameters
ComputationalDomain.nCell = 32 8 8
ComputationalDomain.maxGridSize = 32 8 8
ComputationalDomain.isPeriodic = 1 1 1 # 1 -> periodic, 0 -> else

# Scaling factors
sV = 1
sOmega = 1

# Particle parameters
Particle.speciesNames = electrons ions
Particle.sampler = Sobol
Particle.electrons.nPartPerCell = 20 # number of particles per cell
Particle.electrons.charge = -1.0 # vector (one entry per species)
Particle.electrons.mass = 1.0 # vector (one entry per species)
Particle.electrons.density = "1.0"
Particle.electrons.numGaussians = 1

# Gaussian parameters
Particle.electrons.G0.vMean = 0.0 0.0 0.0
Particle.electrons.G0.vThermal = 0.05 0.05 0.05
Particle.electrons.G0.vWeight = 1.0

Particle.ions.nPartPerCell = 20 # number of particles per cell
Particle.ions.charge = 1.0 # vector (one entry per species)
Particle.ions.mass = 4.0 # vector (one entry per species)
Particle.ions.density = "1.0"
Particle.ions.numGaussians = 1

# Gaussian parameters
Particle.ions.G0.vMean = 0.0 0.0 0.0
Particle.ions.G0.vThermal = 0.025 0.025 0.025
Particle.ions.G0.vWeight = 1.0

# wave vector
k = .1 1 1

# Simulation parameters
TimeLoop.nSteps = 1
TimeLoop.dt = 0.05
TimeLoop.chargeMatrixType = "field_qbym"
TimeLoop.printChecks = 0

# Initial conditions
ICs.Bmean = 0.0 1.0 0.0
Function.idealRho = "0.0"

# Filter
Filter.type = NoFilter

# Diagnostics
# Full Diagnostics
FullDiagnostics.enable = 1 # 1 for true, 0 for false
FullDiagnostics.groupNames = part field
FullDiagnostics.part.varNames = electrons
FullDiagnostics.part.saveInterval = 100000
FullDiagnostics.field.varNames = rho Ex Ey Ez Bx By Bz
FullDiagnostics.field.outputProcessor = CellCenter
FullDiagnostics.field.saveInterval = 5

# Reduced Diagnostics
ReducedDiagnostics.enable = 1 # 1 for true, 0 for false
ReducedDiagnostics.groupNames = Part ElecEnergy MagEnergy #GaussError
ReducedDiagnostics.saveInterval = 1 # output every time step
ReducedDiagnostics.ElecEnergy.types = ElecFieldEnergy
ReducedDiagnostics.MagEnergy.types = MagFieldEnergy
#ReducedDiagnostics.GaussError.types = GaussError
ReducedDiagnostics.Part.types = Particle

div_grad_phi.hypre_solver = GMRES # BoomerAMG(default) GMRES COGMRES LGMRES FlexGMRES BiCGSTAB PCG Hybrid
div_grad_phi.hypre_preconditioner = BoomerAMG # none(default: hypre.hypre_solver=BoomerAMG will only work with hypre.hypre_preconditioner=none) BoomerAMG euclid
div_grad_phi.num_krylov = 50 # integer. Default:50
div_grad_phi.max_iterations = 200 # 10000 # integer. Default:200

div_grad_phi.verbose = 0 # integer. Default:0. 1(print setup info) 2(print solve info) 3(print setup+solve info)
div_grad_phi.logging = 0 # integer. Default:0. >1(latest residual available)
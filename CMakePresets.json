{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "amd-MI300A-env",
            "displayName": "AMD MI300A environment settings",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_HIP_ARCHITECTURES": "gfx942"
            },
            "condition": {
                "type": "anyOf",
                "conditions": [
                    {
                        "type": "matches",
                        "string": "$env{HOSTNAME}",
                        "regex": "^viper[0-9]+$"
                    },
                    {
                        "type": "equals",
                        "lhs": "$env{AMD_ARCHITECTURE}",
                        "rhs": "MI300A"
                    }
                ]
            }
        },
        {
            "name": "gempic-cuda-cache-vars",
            "displayName": "GEMPIC Cache Variables for CUDA",
            "hidden": true,
            "cacheVariables": {
                "GEMPIC_USE_CUDA": "On",
                "GEMPIC_USE_HIP": "Off"
            }
        },
        {
            "name": "gempic-cpu-cache-vars",
            "displayName": "GEMPIC Cache Variables CPU",
            "hidden": true,
            "cacheVariables": {
                "GEMPIC_USE_CUDA": "Off",
                "GEMPIC_USE_HIP": "Off"
            }
        },
        {
            "name": "gempic-hip-cache-vars",
            "displayName": "GEMPIC Cache Variables for HIP",
            "hidden": true,
            "cacheVariables": {
                "GEMPIC_USE_CUDA": "Off",
                "GEMPIC_USE_HIP": "On"
            }
        },
        {
            "name": "mpi-compiler",
            "displayName": "MPI Compiler",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "mpicxx",
                "CMAKE_C_COMPILER": "mpicc"
            }
        },
        {
            "name": "impi-compiler",
            "displayName": "Intel MPI Compiler",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "mpiicpx",
                "CMAKE_C_COMPILER": "mpiicx"
            }
        },
        {
            "name": "amdclang-compiler",
            "displayName": "AMD Clang Compiler",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "amdclang++",
                "CMAKE_C_COMPILER": "amdclang"
            }
        },
        {
            "name": "kokkos-compiler-wrapper",
            "displayName": "Wrapper compiler of kokkos for GPUs",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "${sourceDir}/third_party/kokkos/bin/nvcc_wrapper",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CUDA_COMPILER": "nvcc"
            }
        },
        {
            "name": "mpcdf-viper-3D",
            "displayName": "GPU settings for Viper 3D",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits" : [
                "amd-MI300A-env",
                "mpi-compiler",
                "gempic-hip-cache-vars"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "3"
            }
        },
        {
            "name": "mpcdf-viper-2D",
            "displayName": "GPU settings for Viper 2D",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits" : [
                "amd-MI300A-env",
                "mpi-compiler",
                "gempic-hip-cache-vars"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "2"
            }
        },
        {
            "name": "mpcdf-viper-1D",
            "displayName": "GPU settings for Viper 1D",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits" : [
                "amd-MI300A-env",
                "amdclang-compiler",
                "gempic-hip-cache-vars"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "1"
            }
        },
        {
            "name": "mpcdf-cloud-cuda",
            "displayName": "GPU settings for MPCDF gitlab cloud CUDA runner",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "kokkos-compiler-wrapper",
                "gempic-cuda-cache-vars"
            ],
            "condition": {
                "type": "equals",
                "lhs": "$env{NVIDIA_ARCHITECTURE}",
                "rhs": "A100"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "mpcdf-raven-3D",
            "displayName": "GPU settings for Raven 3D",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "kokkos-compiler-wrapper",
                "gempic-cuda-cache-vars"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "3"
            }
        },
        {
            "name": "mpcdf-raven-2D",
            "displayName": "GPU settings for Raven 2D",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "kokkos-compiler-wrapper",
                "gempic-cuda-cache-vars"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "2"
            }
        },
        {
            "name": "mpcdf-raven-1D",
            "displayName": "GPU settings for Raven 1D",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "kokkos-compiler-wrapper",
                "gempic-cuda-cache-vars"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "1"
            }
        },
        {
            "name": "glibcxx-debug-env",
            "displayName": "libstdc++ debug mode",
            "hidden": true,
            "environment": {
                "CXXFLAGS": "$penv{CXXFLAGS} -fno-omit-frame-pointer -D_GLIBCXX_DEBUG"
            }
        },
        {
            "name": "cpu-debug-3D",
            "displayName": "CPU debug 3D settings",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "glibcxx-debug-env",
                "gempic-cpu-cache-vars",
                "mpi-compiler"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AMReX_SPACEDIM": "3",
                "GEMPIC_USE_LTO": "OFF"
            }
        },
        {
            "name": "cpu-debug-2D",
            "displayName": "CPU debug 2D settings",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "glibcxx-debug-env",
                "gempic-cpu-cache-vars",
                "mpi-compiler"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AMReX_SPACEDIM": "2",
                "GEMPIC_USE_LTO": "OFF"
            }
        },
        {
            "name": "intel-cpu-debug-2D",
            "displayName": "intel-CPU debug 2D settings",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "gempic-cpu-cache-vars",
                "impi-compiler"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AMReX_SPACEDIM": "2",
                "GEMPIC_USE_LTO": "OFF"
            }
        },
        {
            "name": "cpu-debug-1D",
            "displayName": "CPU debug 1D settings",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "glibcxx-debug-env",
                "gempic-cpu-cache-vars",
                "mpi-compiler"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "AMReX_SPACEDIM": "1",
                "GEMPIC_USE_LTO": "OFF"
            }
        },
        {
            "name": "cpu-release-3D",
            "displayName": "CPU release 3D settings",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "gempic-cpu-cache-vars",
                "mpi-compiler"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "3"
            }
        },
        {
            "name": "cpu-release-2D",
            "displayName": "CPU release 2D settings",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "gempic-cpu-cache-vars",
                "mpi-compiler"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "2"
            }
        },
        {
            "name": "cpu-release-1D",
            "displayName": "CPU release 1D settings",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "inherits": [
                "gempic-cpu-cache-vars",
                "mpi-compiler"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "AMReX_SPACEDIM": "1"
            }
        },
        {
            "name": "documentation",
            "displayName": "Build only GEMPIC documentation",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
              "GEMPIC_BUILD_ONLY_DOCUMENTATION": "ON"
            }
        },
        {
            "name": "vs-intelOneAPI-release",
            "displayName": "VS2022 + Intel oneAPI Release",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "toolset": "Intel C++ Compiler 2025,fortran=ifx",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_Fortran_FLAGS": "/MP",
                "CMAKE_EXE_LINKER_FLAGS": "/Qopenmp",
                "GEMPIC_USE_HDF5": false
             },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "vs-intelOneAPI-debug",
            "displayName": "VS2022 + Intel oneAPI Debug",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "toolset": "Intel C++ Compiler 2025,fortran=ifx",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_Fortran_FLAGS": "/MP",
                "CMAKE_EXE_LINKER_FLAGS": "/Qopenmp",
                "GEMPIC_USE_HDF5": false
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ]
}
